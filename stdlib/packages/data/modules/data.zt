-- Canonical source for first-order Data helpers.
-- Explicit import only: `d ::= import stdlib.data`; these names are not ambient.
r ::= import stdlib.result;
DataField :: type { name : Text; value : Data; };
Data :: type {
  #bool : { value : Bool; };
  #int : { value : Int; };
  #float : { value : Float; };
  #text : { value : Text; };
  #atom : { value : Text; };
  #list : { items : List Data; };
  #record : { fields : List DataField; };
  #tagged : { payload : Data; tag : Text; };
};
DecodeError :: type {
  #expected : { expected : Text; actual : Text; };
  #missingField : { name : Text; };
  #indexOutOfBounds : { index : Int; };
  #custom : { message : Text; };
};
Result :: <E, A> type r.Result E A;
Validation :: <E, A> type r.Validation E A;
DecodePath :: type {
  #field : { name : Text; };
  #index : { index : Int; };
  #variant : { name : Text; };
};
DecodeIssue :: type { path : List DecodePath; error : DecodeError; };
bool :: Bool -> Data
  = value => #bool { value =; };
int :: Int -> Data
  = value => #int { value =; };
float :: Float -> Data
  = value => #float { value =; };
text :: Text -> Data
  = value => #text { value =; };
atom :: Text -> Data
  = value => #atom { value =; };
list :: List Data -> Data
  = items => #list { items =; };
record :: List DataField -> Data
  = fields => #record { fields =; };
tagged :: Text -> Data -> Data
  = tag payload => #tagged { tag =; payload =; };
fieldOf :: Text -> Data -> DataField
  = name value => { name =; value =; };
kind :: Data -> Text
  = data => match data { | #bool { value = _; } => "bool"; | #int { value = _; } => "int"; | #float { value = _; } => "float"; | #text { value = _; } => "text"; | #atom { value = _; } => "atom"; | #list { items = _; } => "list"; | #record { fields = _; } => "record"; | #tagged { tag = _; payload = _; } => "tagged"; };
expectedError :: Text -> Data -> DecodeError
  = name data => #expected { expected = name; actual = kind data; };
missingFieldError :: Text -> DecodeError
  = name => #missingField { name =; };
indexOutOfBoundsError :: Int -> DecodeError
  = index => #indexOutOfBounds { index =; };
expected :: <A> Text -> Data -> Result DecodeError A
  = name data => #err { error = expectedError name data; };
asBool :: Data -> Result DecodeError Bool
  = data => match data { | #bool { value =; } => #ok { value =; }; | _ => expected "bool" data; };
asInt :: Data -> Result DecodeError Int
  = data => match data { | #int { value =; } => #ok { value =; }; | _ => expected "int" data; };
asFloat :: Data -> Result DecodeError Float
  = data => match data { | #float { value =; } => #ok { value =; }; | _ => expected "float" data; };
asText :: Data -> Result DecodeError Text
  = data => match data { | #text { value =; } => #ok { value =; }; | _ => expected "text" data; };
asAtom :: Data -> Result DecodeError Text
  = data => match data { | #atom { value =; } => #ok { value =; }; | _ => expected "atom" data; };
asList :: Data -> Result DecodeError (List Data)
  = data => match data { | #list { items =; } => #ok { value = items; }; | _ => expected "list" data; };
asRecord :: Data -> Result DecodeError (List DataField)
  = data => match data { | #record { fields =; } => #ok { value = fields; }; | _ => expected "record" data; };
asTagged :: Data -> Result DecodeError { tag : Text; payload : Data; }
  = data => match data { | #tagged { tag =; payload =; } => #ok { value = { tag =; payload =; }; }; | _ => expected "tagged" data; };
findField :: Text -> List DataField -> Data?
  = name fields => match fields { | {;} => #none; | {field; ...rest} => if field.name == name then #some (field.value) else findField name rest; };
field :: Text -> Data -> Result DecodeError Data
  = name data => match asRecord data { | #err { error =; } => #err { error =; }; | #ok { value = fields; } => match findField name fields { | #none => #err { error = missingFieldError name; }; | #some (value) => #ok { value =; }; }; };
fieldMaybe :: Text -> Data -> Result DecodeError (Data?)
  = name data => match asRecord data { | #err { error =; } => #err { error =; }; | #ok { value = fields; } => match findField name fields { | #none => #ok { value = #none; }; | #some (value) => #ok { value = #some (value); }; }; };
atList :: Int -> List Data -> Result DecodeError Data
  = index items => if index < 0 then #err { error = indexOutOfBoundsError index; } else match items { | {;} => #err { error = indexOutOfBoundsError index; }; | {head; ...tail} => if index == 0 then #ok { value = head; } else atList (index - 1) tail; };
at :: Int -> Data -> Result DecodeError Data
  = index data => match asList data { | #err { error =; } => #err { error =; }; | #ok { value = items; } => atList index items; };
tag :: Data -> Result DecodeError Text
  = data => match asTagged data { | #err { error =; } => #err { error =; }; | #ok { value = parts; } => #ok { value = parts.tag; }; };
payload :: Data -> Result DecodeError Data
  = data => match asTagged data { | #err { error =; } => #err { error =; }; | #ok { value = parts; } => #ok { value = parts.payload; }; };
mapListItems :: <A> (Data -> Result DecodeError A) -> List Data -> Result DecodeError (List A)
  = f items => match items { | {;} => #ok { value = listEmpty (); }; | {head; ...tail} => match f head { | #err { error =; } => #err { error =; }; | #ok { value =; } => match mapListItems f tail { | #err { error =; } => #err { error =; }; | #ok { value = values; } => #ok { value = listCons value values; }; }; }; };
mapList :: <A> (Data -> Result DecodeError A) -> Data -> Result DecodeError (List A)
  = f data => match asList data { | #err { error =; } => #err { error =; }; | #ok { value = items; } => mapListItems f items; };
{ Data =; DataField =; DecodeError =; DecodePath =; DecodeIssue =; Result =; Validation =; bool =; int =; float =; text =; atom =; list =; record =; tagged =; fieldOf =; kind =; asBool =; asInt =; asFloat =; asText =; asAtom =; asList =; asRecord =; asTagged =; field =; field? = fieldMaybe; at =; tag =; payload =; mapList =; }
